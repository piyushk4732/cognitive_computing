      "outputs": [],
      "source": [
        "emergency_keywords = [\n",
        "    \"chest pain\", \"crushing chest\", \"chest pressure\", \"cannot breathe\",\n",
        "    \"can't breathe\", \"severe shortness of breath\", \"fainting\",\n",
        "    \"face drooping\", \"one side weakness\", \"slurred speech\"\n",
        "]\n",
        "\n",
        "def is_emergency(query):\n",
        "    query_lower = query.lower()\n",
        "    return any(keyword in query_lower for keyword in emergency_keywords)\n",
        "\n",
        "def retrieve_response(query, confidence_threshold=0.35, similarity_threshold=0.08):\n",
        "    if is_emergency(query):\n",
        "        return {\n",
        "            \"intent\": \"emergency\",\n",
        "            \"confidence\": 1.0,\n",
        "            \"response\": \"This may be a medical emergency. Call your local emergency number immediately (112 in India) or go to the nearest emergency department. Do not drive yourself. Do not wait for an online response. This assistant cannot assess or rule out an emergency.\"\n",
        "        }\n",
        "\n",
        "    processed = preprocess_text(query)\n",
        "    query_vector = vectorizer.transform([processed])\n",
        "\n",
        "    if query_vector.nnz == 0:\n",
        "        return {\n",
        "            \"intent\": \"unsupported\",\n",
        "            \"confidence\": 0.0,\n",
        "            \"response\": \"I can only help with general heart-health information. Please ask a question about heart symptoms, prevention, risk factors, lifestyle, or screening.\"\n",
        "        }\n",
        "\n",
        "    similarities = cosine_similarity(query_vector, X_train_tfidf)\n",
        "    best_similarity = float(np.max(similarities))\n",
        "\n",
        "    if best_similarity < similarity_threshold:\n",
        "        return {\n",
        "            \"intent\": \"unsupported\",\n",
        "            \"confidence\": 0.0,\n",
        "            \"response\": \"This question appears outside my heart-health knowledge area. Please ask a question about heart symptoms, prevention, risk factors, lifestyle, or screening.\"\n",
        "        }\n",
        "\n",
        "    probabilities = model.predict_proba(query_vector)[0]\n",
        "    predicted_index = int(np.argmax(probabilities))\n",
        "    predicted_intent = model.classes_[predicted_index]\n",
        "    confidence = float(probabilities[predicted_index])\n",
        "\n",
        "    if confidence < confidence_threshold:\n",
        "        return {\n",
        "            \"intent\": \"low confidence\",\n",
        "            \"confidence\": confidence,\n",
        "            \"response\": \"I am not confident enough to classify this question reliably. Please rephrase it or consult a qualified healthcare professional.\"\n",
        "        }\n",
        "\n",
        "    return {\n",
        "        \"intent\": predicted_intent,\n",
        "        \"confidence\": confidence,\n",
        "        \"response\": knowledge_base[predicted_intent]\n",
        "    }\n",
        "\n",
        "def heart_health_assistant(query):\n",
        "    result = retrieve_response(query)\n",
        "    print(\"User query:\", query)\n",
        "    print(\"Detected intent:\", result[\"intent\"])\n",
        "    print(\"Confidence:\", round(result[\"confidence\"], 3))\n",
        "    print(\"Assistant response:\", result[\"response\"])\n",
        "    return result"
      ]
    },
