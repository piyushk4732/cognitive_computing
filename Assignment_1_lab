sum = 0
for i in range(1, n + 1):
    if i % 7 == 0 and i % 9 == 0:
        sum = sum + i
print("Sum =", sum)


//Assingment 5.3: WAP to add all prime numbers from 1 to n and n is given by the user
n = int(input("Enter a number: "))
sum = 0
for i in range(2, n + 1):
    prime = True
    for j in range(2, i):
        if i % j == 0:
            prime = False
            break
    if prime:
        sum = sum + i
print("Sum of prime numbers =", sum)



